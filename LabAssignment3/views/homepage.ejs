<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bonanza Satrangi – Spring/Summer '26</title>
    <meta name="description" content="Explore Bonanza Satrangi's premium fashion collection featuring dresses, fragrances, and beauty products.">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('partials/flash') %>
    <div class="top-bar">
        Free shipping on orders above Rs. 3,000
    </div>

    <section class="logo-section">
        <div class="container">
            <img src="/images/bonanza_logo.svg" alt="Bonanza Satrangi Logo" class="main-logo">
        </div>
    </section>

    <header>
        <nav class="navbar">
            <div class="hamburger" id="hamburger"><i class="fas fa-bars"></i></div>
            <div class="menu" id="nav-menu">
                <a href="/">SPRING/SUMMER'26</a>
                <a href="#" >FESTIVE EDIT</a>
                <a href="#" >NEW ARRIVALS</a>
                <a href="#" >READY TO WEAR</a>
                <a href="/products?category=dress">DRESSES</a>
                <a href="/products?category=unstitched">UNSTITCHED</a>
                <a href="/products?category=perfume">FRAGRANCES</a>
                <a href="/products?category=beauty">BEAUTY</a>
                <a href="/products">ALL PRODUCTS</a>
                <a href="/contact-us">CONTACT</a>
            </div>
            <div class="icons">
                <a href="/products"><i class="fas fa-search"></i></a>
                <% if (user) { %>
                    <% if (user.role === 'admin') { %>
                        <a href="/admin" title="Admin Panel"><i class="fas fa-shield-alt"></i></a>
                    <% } %>
                    <a href="/logout" title="Logout (<%= user.name %>)"><i class="fas fa-sign-out-alt"></i></a>
                <% } else { %>
                    <a href="/login" title="Login / Register"><i class="fas fa-user"></i></a>
                <% } %>
                <a href="/favourites"><i class="fas fa-heart"></i><span class="badge"><%= typeof favouritesCount !== 'undefined' ? favouritesCount : 0 %></span></a>
                <a href="/cart"><i class="fas fa-shopping-bag"></i><span class="badge"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span></a>
            </div>
        </nav>
    </header>

    <section class="hero">
        <img src="/images/hero picture.webp" alt="Spring Summer Collection Banner">
    </section>

    <section class="collection-filter">
        <ul>
            <li class="active" onclick="window.location.href='/products?category=unstitched';" style="cursor: pointer;">UNSTITCHED</li>
            <li onclick="window.location.href='/products?category=dress';" style="cursor: pointer;">READY TO WEAR</li>
            <li>MENSWEAR</li>
            <li onclick="window.location.href='/products?category=perfume';" style="cursor: pointer;">FRAGRANCES</li>
            <li onclick="window.location.href='/products?category=beauty';" style="cursor: pointer;">BEAUTY</li>
        </ul>
    </section>

    <section class="category-grid">
        <div class="category-card" onclick="window.location.href='/products?category=unstitched';" style="cursor: pointer;">
            <img src="/images/unstiched.banner.webp" alt="Unstitched">
            <div class="overlay-text">
                <h2>UNSTITCHED</h2>
                <p>SHOP NOW</p>
            </div>
        </div>
        <div class="category-card" onclick="window.location.href='/products?category=dress';" style="cursor: pointer;">
            <img src="/images/product1.webp" alt="2 Piece">
            <div class="overlay-text">
                <h2>2 PIECE</h2>
                <p>SHOP NOW</p>
            </div>
        </div>
        <div class="category-card" onclick="window.location.href='/products?category=dress';" style="cursor: pointer;">
            <img src="/images/product5.webp" alt="3 Piece">
            <div class="overlay-text">
                <h2>3 PIECE</h2>
                <p>SHOP NOW</p>
            </div>
        </div>
    </section>

    <section class="ready-section">
        <div class="ready-card" onclick="window.location.href='/products?category=dress';" style="cursor: pointer;">
            <img src="/images/product6.webp" alt="Embroidered">
            <div class="ready-text">
                <h2>READY TO WEAR</h2>
                <p>EMBROIDERED</p>
            </div>
        </div>
        <div class="ready-card" onclick="window.location.href='/products?category=dress';" style="cursor: pointer;">
            <img src="/images/product9.webp" alt="Printed">
            <div class="ready-text">
                <h2>READY TO WEAR</h2>
                <p>PRINTED</p>
            </div>
        </div>
        <div class="ready-card" onclick="window.location.href='/products?category=dress';" style="cursor: pointer;">
            <img src="/images/product8.webp" alt="Ready to Wear Shop">
            <div class="ready-text">
                <h2>READY TO WEAR</h2>
                <p>SHOP NOW</p>
            </div>
        </div>
    </section>

    <section class="category-grid fragrance-grid">
        <div class="category-card" onclick="window.location.href='/products?category=perfume';" style="cursor: pointer;">
            <img src="/images/fragnance1.webp" alt="Fragrances Main">
            <div class="overlay-text"><h2>FRAGRANCES</h2><p>SHOP NOW</p></div>
        </div>
        <div class="category-card" onclick="window.location.href='/products?category=perfume';" style="cursor: pointer;">
            <img src="/images/fragnance2.webp" alt="Women Fragrance">
            <div class="overlay-text"><h2>WOMEN</h2></div>
        </div>
        <div class="category-card" onclick="window.location.href='/products?category=perfume';" style="cursor: pointer;">
            <img src="/images/fragnance3.webp" alt="Men Fragrance">
            <div class="overlay-text"><h2>MEN</h2></div>
        </div>
    </section>

    <section class="beauty-container">
        <div class="beauty-item" onclick="window.location.href='/products?category=beauty';" style="cursor: pointer;">
            <img src="/images/beautyproduct3.webp" alt="Hair Care">
            <div class="beauty-label">HAIR CARE</div>
        </div>
        <div class="beauty-item" onclick="window.location.href='/products?category=beauty';" style="cursor: pointer;">
            <img src="/images/beautyproduct2.webp" alt="Skincare">
            <div class="beauty-label">SKINCARE</div>
        </div>
        <div class="beauty-item" onclick="window.location.href='/products?category=beauty';" style="cursor: pointer;">
            <img src="/images/beautyproduct1.webp" alt="Makeup">
            <div class="beauty-label">MAKEUP</div>
        </div>
    </section>

    <!-- Shop Now CTA -->
    <section class="cta-section">
        <div class="cta-content">
            <h2>Explore Our Full Collection</h2>
            <p>Discover dresses, fragrances & beauty essentials</p>
            <a href="/products" class="cta-btn">SHOP ALL PRODUCTS</a>
        </div>
    </section>

    <footer class="main-footer">
        <div class="footer-container">
            <div class="footer-column">
                <h3>CONTACT US</h3>
                <p>📞 +92 21 111-244-266</p>
                <p>✉ info@bonanzasatrangi.com</p>
                <p>Monday - Saturday: 9:30 AM – 10:00 PM</p>
            </div>
            <div class="footer-column">
                <h3>INFORMATION</h3>
                <p>About Us</p>
                <p>Track Your Order</p>
                <p>Store Locator</p>
            </div>
            <div class="footer-column">
                <h3>CUSTOMER CARE</h3>
                <p>Privacy Policy</p>
                <p>Return & Exchange</p>
                <p>FAQs</p>
            </div>
            <div class="footer-column newsletter">
                <h3>NEWSLETTER</h3>
                <div class="newsletter-box">
                    <input type="email" placeholder="Enter Email">
                    <button>→</button>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 Bonanza Satrangi. Powered By SIAR</p>
        </div>
    </footer>

    <script src="/js/script.js"></script>
</body>

</html>
