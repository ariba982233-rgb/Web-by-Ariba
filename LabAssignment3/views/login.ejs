<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Bonanza Satrangi</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .auth-container { max-width: 400px; margin: 80px auto; padding: 40px; background: #fff; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border-radius: 8px; text-align: center; }
        .auth-container h1 { font-family: 'Cormorant Garamond', serif; margin-bottom: 30px; font-size: 2.5rem; }
        .form-group { margin-bottom: 20px; text-align: left; }
        .form-group label { display: block; margin-bottom: 8px; font-weight: 500; font-size: 0.9rem; color: #555; }
        .form-group input { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; font-family: 'Inter', sans-serif; }
        .auth-btn { width: 100%; padding: 14px; background: #000; color: #fff; border: none; border-radius: 4px; font-weight: 600; cursor: pointer; transition: 0.3s; margin-top: 10px; }
        .auth-btn:hover { background: #333; }
        .auth-links { margin-top: 20px; font-size: 0.9rem; }
        .auth-links a { color: #000; text-decoration: underline; }
        
        /* Flash Messages */
        .flash-msg { padding: 15px; margin-bottom: 20px; border-radius: 4px; font-size: 0.9rem; text-align: left; }
        .flash-success { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .flash-error { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    </style>
</head>
<body>
    <%- include('partials/flash') %>
    <section class="logo-section" style="padding-top: 20px;">
        <div class="container" style="text-align: center;">
            <a href="/"><img src="/images/bonanza_logo.svg" alt="Bonanza Satrangi Logo" class="main-logo" style="width: 250px;"></a>
        </div>
    </section>

    <div class="auth-container">
        <h1>Login to Your Account</h1>
        
        <form action="/login" method="POST">
            <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" required placeholder="Enter your email">
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required placeholder="Enter your password">
            </div>
            <button type="submit" class="auth-btn">Sign In</button>
        </form>
        
        <div class="auth-links">
            <p><a href="/forgot-password">Forgot your password?</a></p>
            <p>Don't have an account? <a href="/register">Register here</a></p>
            <p><a href="/">Return to Store</a></p>
        </div>
    </div>
</body>
</html>
