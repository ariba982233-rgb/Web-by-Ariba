<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bonanza Satrangi</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="top-bar">
        This is the only official Bonanza Satrangi website.
    </div>

    <section class="logo-section">
        <div class="container">
            <img src="/images/bonanza_logo.svg" alt="Bonanza Satrangi Logo" class="main-logo">
        </div>
    </section>

    <header>
        <nav class="navbar">
            <div class="hamburger" id="hamburger">
                <i class="fas fa-bars"></i>
            </div>

            <div class="menu" id="nav-menu">
                <a href="/">SPRING/SUMMER'26</a>
                <a href="#">FESTIVE EDIT</a>
                <a href="#">NEW ARRIVALS</a>
                <a href="#">READY TO WEAR</a>
                <a href="#">BUNDLES</a>
                <a href="#">UNSTITCHED</a>
                <a href="#">BEAUTY</a>
                <a href="#">KIDS</a>
                <a href="#">SOCKS</a>
                <a href="#">ACCESSORIES</a>
                <a href="#">WESTERN</a>
                <a href="#">FRAGRANCES</a>
                <a href="#">MEN</a>
                <a href="#">SALE</a>
            </div>
            <div class="icons">
                <a href="#"><i class="fas fa-search"></i></a>
                <a href="#"><i class="fas fa-user"></i></a>
                <a href="#"><i class="fas fa-heart"></i><span class="badge">0</span></a>
                <a href="#"><i class="fas fa-shopping-bag"></i><span class="badge">0</span></a>
            </div>
        </nav>
    </header>

    <section class="hero">
        <img src="/images/hero picture.webp" alt="Spring Summer Collection Banner">
    </section>

    <section class="collection-filter">
        <ul>
            <li class="active">UNSTITCHED</li>
            <li>READY TO WEAR</li>
            <li>MENSWEAR</li>
            <li>FRAGRANCES</li>
            <li>BEAUTY</li>
        </ul>
    </section>

    <section class="category-grid">
         <div class="category-card">
            <img src="/images/unstiched.banner.webp" alt="Unstitched">
            <div class="overlay-text">
                <h2>UNSTITCHED</h2>
                <p>SHOP NOW</p>
            </div>
        </div>
        <div class="category-card">
            <img src="/images/product1.webp" alt="2 Piece">
            <div class="overlay-text">
                <h2>2 PIECE</h2>
                <p>SHOP NOW</p>
            </div>
        </div>
        <div class="category-card">
            <img src="/images/product5.webp" alt="3 Piece">
            <div class="overlay-text">
                <h2>3 PIECE</h2>
                <p>SHOP NOW</p>
            </div>
        </div>
    </section>

    <section class="ready-section">
        <div class="ready-card">
            <img src="/images/product6.webp" alt="Embroidered">
            <div class="ready-text">
                <h2>READY TO WEAR</h2>
                <p>EMBROIDERED</p>
            </div>
        </div>

        <div class="ready-card">
            <img src="/images/product9.webp" alt="Printed">
            <div class="ready-text">
                <h2>READY TO WEAR</h2>
                <p>PRINTED</p>
            </div>
        </div>
        
        <div class="ready-card">
            <img src="/images/product8.webp" alt="Ready to Wear Shop">
            <div class="ready-text">
                <h2>READY TO WEAR</h2>
                <p>SHOP NOW</p>
            </div>
        </div>
    </section>


    <section class="category-grid fragrance-grid">
        <div class="category-card">
            <img src="/images/fragnance1.webp" alt="Fragrances Main">
            <div class="overlay-text">
                <h2>FRAGRANCES</h2>
                <p>SHOP NOW</p>
            </div>
        </div>

        <div class="category-card">
            <img src="/images/fragnance2.webp" alt="Women Fragrance">
            <div class="overlay-text">
                <h2>WOMEN</h2>
            </div>
        </div>

        <div class="category-card">
            <img src="/images/fragnance3.webp" alt="Men Fragrance">
            <div class="overlay-text">
                <h2>MEN</h2>
            </div>
        </div>
    </section>

    <section class="beauty-container">
        <div class="beauty-item">
            <img src="/images/beautyproduct3.webp" alt="Hair Care">
            <div class="beauty-label">HAIR CARE</div>
        </div>
        <div class="beauty-item">
            <img src="/images/beautyproduct2.webp" alt="Skincare">
            <div class="beauty-label">SKINCARE</div>
        </div>
        <div class="beauty-item">
            <img src="/images/beautyproduct1.webp" alt="Makeup">
            <div class="beauty-label">MAKEUP</div>
        </div>
    </section>

    <footer class="main-footer">
        <div class="footer-container">
            <div class="footer-column">
                <h3>CONTACT US</h3>
                <p>📞 +92 21 111-244-266</p>
                <p>✉ info@bonanzasatrangi.com</p>
                <p>Monday - Saturday: 9:30 AM – 10:00 PM</p>
            </div>
            <div class="footer-column">
                <h3>INFORMATION</h3>
                <p>About Us</p>
                <p>Track Your Order</p>
                <p>Store Locator</p>
            </div>
            <div class="footer-column">
                <h3>CUSTOMER CARE</h3>
                <p>Privacy Policy</p>
                <p>Return & Exchange</p>
                <p>FAQs</p>
            </div>
            <div class="footer-column newsletter">
                <h3>NEWSLETTER</h3>
                <div class="newsletter-box">
                    <input type="email" placeholder="Enter Email">
                    <button>→</button>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 Bonanza Satrangi. Powered By SIAR</p>
        </div>
    </footer>
    <script src="/js/script.js"></script>
</body>

</html>
